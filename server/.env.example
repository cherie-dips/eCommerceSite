# Copy this file to server/.env and fill in the values.

# --- Required ---
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/flagzen
JWT_SECRET=use-a-long-random-string-here
PORT=5050

# Website address (used in email links and allowed to call the API).
CLIENT_URL=http://localhost:5173
# Extra website addresses allowed to call the API, comma separated (e.g. your live site)
FRONTEND_URL=

# --- Google sign-in (optional) ---
GOOGLE_CLIENT_ID=

# --- Razorpay payments (optional: without keys, checkout runs in test mode) ---
# Get test keys at https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> URL https://<server>/api/payments/razorpay/webhook, events payment.captured + order.paid
RAZORPAY_WEBHOOK_SECRET=

# --- Email (optional: without SMTP, emails are printed in the server console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Flagzen <no-reply@yourdomain.com>

# --- AI design suggestions (optional: the free suggestions always work) ---
# https://console.anthropic.com -> API keys. Each AI suggestion request costs a few cents.
ANTHROPIC_API_KEY=
AI_SUGGESTIONS_PER_HOUR=10

# Unpaid orders are cancelled after this many minutes
PENDING_ORDER_MINUTES=30

# Demo data (npm run seed)
SEED_SELLER_EMAIL=demo-seller@flagzen.local
SEED_SELLER_PASSWORD=
